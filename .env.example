# ──────────────────────────────────────────────────────────────
# DeepCode Agent — Environment Configuration
# Copy this to .env and modify as needed
# ──────────────────────────────────────────────────────────────

# App
APP_NAME=DeepCode Agent
APP_VERSION=0.1.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# LLM Provider: ollama | openai | anthropic
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:latest
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Embedding
EMBEDDING_MODEL=nomic-embed-text

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/deepcode

# Logging
LOG_LEVEL=INFO
